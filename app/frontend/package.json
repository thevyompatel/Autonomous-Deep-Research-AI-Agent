{
  "name": "deep-research-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Web UI for the Autonomous Deep Research AI Agent",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
