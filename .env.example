GEMINI_API_KEY=your_key_here
TAVILY_API_KEY=your_key_here
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Optional: override the default Gemini model
# MODEL_NAME=gemini-3.5-flash-lite

# Client-side Gemini rate limits (keep below your quota; see aistudio.google.com/rate-limit)
LLM_REQUESTS_PER_MINUTE=4
# 0 disables the daily cap
LLM_REQUESTS_PER_DAY=20

# Web UI address (python -m app.web)
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
